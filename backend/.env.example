# Copy this file to .env and fill it in.

# MySQL: mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE  (the database is created automatically)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/answer_eval

# LLM: "gemini" (free tier) or "mock" (fake data, no key needed, for trying the UI)
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier supports Flash / Flash-Lite models. Check Google's rate-limit page if this name stops working.
GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait between sheets so the free-tier rate limit is not hit
GEMINI_DELAY_SECONDS=4
