# PostgreSQL connection (replace credentials with your own local PostgreSQL user/password)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/answer_eval

# Local Ollama vision model
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=300

# Local OCR (Windows example; update if Tesseract is installed elsewhere)
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

MAX_UPLOAD_MB=20
MIN_CONFIDENCE=0.6
NUMERIC_TOLERANCE=0.01
PROCESSING_WORKERS=2

# Login / registration
AUTH_REQUIRED=true
# Leave empty to auto-create backend/.auth_secret on first run, or set a long random string
AUTH_SECRET_KEY=
AUTH_TOKEN_HOURS=12

# Forgot password e-mails. Leave SMTP_HOST empty while developing: the reset link is then printed in the server console.
APP_BASE_URL=http://127.0.0.1:8000
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
